# Contraseña para entrar al panel de administración (TU-DOMINIO/admin)
ADMIN_PASSWORD=cambia-esta-clave-ya

# Google Drive (OAuth) — se crean en console.cloud.google.com (sección 2 del README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token permanente de Drive (necesario en Render: campo driveTokens.refresh_token de data/local.json)
GOOGLE_REFRESH_TOKEN=

# Puerto local (no tocar si subes a Render)
PORT=3000
